---
import { socialNav } from '#src/config/nav.ts'
---

<footer>
	<nav class="flex justify-center py-4">
		<ul class="flex items-center">
			{socialNav.map(({ href, title, Icon }) => (
				<li>
					<a
						href={href}
						target="_blank"
						aria-label={title}
						class="group icon-button relative"
					>
						<Icon class="size-[1em]" aria-hidden="true" />
						<span
							aria-hidden="true"
							class="bg-foreground text-background after:bg-foreground pointer-events-none absolute bottom-full mb-2 rounded-md px-3 py-1.5 text-xs opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 after:absolute after:top-full after:left-1/2 after:size-2.5 after:-translate-1/2 after:rotate-45 after:rounded-[2px]"
						>
							{title}
						</span>
					</a>
				</li>
			))}
		</ul>
	</nav>
</footer>
