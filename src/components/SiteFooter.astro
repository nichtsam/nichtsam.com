---
import { socialLinks } from '#src/utils/social-links.ts'
---

<footer class="grid gap-x-6 gap-y-2 border-t border-foreground pt-8 pb-16 font-mono text-[13px] text-muted md:grid-cols-12 md:pt-10">
	<p class="md:col-span-3">nichtsam.com</p>
	<ul class="flex flex-wrap gap-x-7 gap-y-2 md:col-span-9">
		{socialLinks.map(({ href, title }) => (
			<li>
				<a href={href} target="_blank">
					{title} ↗
				</a>
			</li>
		))}
	</ul>
</footer>
