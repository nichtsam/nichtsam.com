---
import { socialLinks } from '#src/utils/social-links.ts'

const sectionNav = [
	{ title: 'Projects', href: '/#projects' },
	{ title: 'Skills', href: '/#skills' },
	{ title: 'Articles', href: '/#articles' },
]

// Articles have no list page, so the home page's list stands in for it
const isArticle = Astro.url.pathname.startsWith('/articles/')
---

<header class="grid items-baseline gap-x-6 gap-y-2 border-b border-foreground py-7 md:grid-cols-12">
	<a href="/" class="text-[22px] font-medium italic no-underline md:col-span-3">
		nichtsam
	</a>

	<nav
		aria-label="Primary"
		class="flex flex-wrap justify-between gap-x-7 gap-y-2 font-mono text-[13px] text-muted md:col-span-9"
	>
		<ul class="flex flex-wrap gap-x-7 gap-y-2">
			{sectionNav.map(({ href, title }) => (
				<li>
					<a
						href={href}
						aria-current={
							title === 'Articles' && isArticle ? 'true' : undefined
						}
						class="aria-[current]:text-foreground"
					>
						{title}
					</a>
				</li>
			))}
		</ul>
		<ul class="flex flex-wrap gap-x-7 gap-y-2">
			{socialLinks.map(({ href, title }) => (
				<li>
					<a href={href} target="_blank">
						{title} ↗
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>
