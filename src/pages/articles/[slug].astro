---
import { getCollection, render } from 'astro:content'
import ArticleImage from '#src/components/ArticleImage.astro'
import Layout from '#src/layouts/Layout.astro'
import { type Article } from '#src/utils/articles.ts'

export async function getStaticPaths() {
	const articles = await getCollection('articles')

	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}))
}

interface Props {
	article: Article
}

const { article } = Astro.props
const { Content } = await render(article)
---

<Layout
	title={`${article.data.title} | nichtsam`}
	description={article.data.description}
>
	<article class="container prose xl:prose-lg 2xl:prose-2xl">
		<Content components={{ ArticleImage }} />
	</article>
</Layout>
