---
import Layout from '#src/layouts/Layout.astro'
import {
	articlePath,
	articleReadingTime,
	formatPublishedDate,
	getPublishedArticles,
} from '#src/utils/articles.ts'

const articles = await getPublishedArticles()
---

<Layout
	title="Articles | nichtsam"
	description="Articles written by Samuel, where he shares his thoughts, ideas, and insights on a variety of topics."
>
	<div class="container max-w-[80ch]">
		<ul class="flex flex-col gap-y-2">
			{articles.map((article) => (
				<li>
					<a
						href={articlePath(article.id)}
						class="inline-block w-full rounded-md p-4 transition ease-out hover:scale-105 hover:bg-accent hover:text-accent-foreground"
					>
						<div class="flex flex-col">
							<time datetime={article.data.publishedDate.toISOString()}>
								{formatPublishedDate(article.data.publishedDate)}
							</time>
							<h3 class="text-lg">{article.data.title}</h3>
							<span class="text-sm text-muted-foreground">
								{articleReadingTime(article)}
							</span>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>
