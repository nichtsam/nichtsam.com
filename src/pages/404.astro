---
import ArrowLeft from '#src/icons/arrow-left.svg'
import Layout from '#src/layouts/Layout.astro'
---

<Layout
	title="Not Found"
	description="Sorry, I couldn't find this page for you 😭"
>
	<div class="container flex items-center justify-center py-20">
		<div class="flex flex-col gap-6">
			<h1 class="text-2xl sm:text-4xl md:text-5xl">We can't find this page</h1>
			<a href="/" class="flex items-center gap-2 self-start text-lg">
				<ArrowLeft class="size-[1em]" aria-hidden="true" />
				Back to home
			</a>
		</div>
	</div>
</Layout>
